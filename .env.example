# Copy to .env and fill in. Motion mails are disabled while SMTP_HOST or MAIL_TO is empty.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (usually port 587), ssl (usually port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=cam@example.com
SMTP_PASSWORD=change-me
# Defaults to SMTP_USER
MAIL_FROM=cam@example.com
# Comma-separated recipients
MAIL_TO=me@example.com
# Minimum time between two mails of the same camera
MAIL_COOLDOWN_MINUTES=5
# Hub address used for the link in the mail
HUB_URL=http://192.168.2.38:5000
